<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Registers "DGA Government" as one more choice in the SAME header
         and footer "Template" pickers Odoo already ships (Website >
         Configure > Theme > Header/Footer), instead of building a
         parallel selection system - see website/views/snippets/snippets.xml
         for the we-select this extends. -->
    <template id="website_header_footer_options" inherit_id="website.snippet_options"
              name="DGA Government Header/Footer Options">
        <xpath expr="//we-select[@data-variable='header-template']" position="inside">
            <we-button title="DGA Government"
                       data-name="header_dga_opt"
                       data-trigger="regular_header_visibility_opt"
                       data-customize-website-views="sa_dga_theme_website.template_header_dga"
                       data-customize-website-variable="'dga'"
                       data-img="/website/static/src/img/snippets_options/header_template_default.svg"/>
        </xpath>
        <xpath expr="//we-select[@data-variable='footer-template']" position="inside">
            <we-button title="DGA Government"
                       data-customize-website-views="sa_dga_theme_website.template_footer_dga"
                       data-customize-website-variable="'dga'"
                       data-img="/website/static/src/img/snippets_options/footer_template_default.svg"/>
        </xpath>
    </template>
</odoo>
