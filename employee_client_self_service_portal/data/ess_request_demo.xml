<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ess_demo_client_partner" model="res.partner">
        <field name="name">Northwind Client Co.</field>
        <field name="email">client.demo@example.com</field>
        <field name="company_type">company</field>
    </record>

    <record id="ess_demo_client_user" model="res.users">
        <field name="name">Demo Client Contact</field>
        <field name="login">demo_client</field>
        <field name="email">client.demo@example.com</field>
        <field name="partner_id" ref="ess_demo_client_partner"/>
        <field name="groups_id" eval="[(6, 0, [ref('employee_client_self_service_portal.group_ess_client')])]"/>
    </record>

    <record id="ess_demo_request_manager" model="res.users">
        <field name="name">Demo Request Manager</field>
        <field name="login">demo_request_manager</field>
        <field name="email">request.manager.demo@example.com</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('employee_client_self_service_portal.group_ess_request_manager')])]"/>
    </record>

    <record id="ess_demo_request_1" model="ess.request">
        <field name="request_type_id" ref="ess_request_type_letter"/>
        <field name="requester_kind">employee</field>
        <field name="employee_id" ref="hr.employee_hne"/>
        <field name="subject">Salary certificate for visa application</field>
        <field name="description">Need a salary certificate addressed to the embassy.</field>
        <field name="priority">normal</field>
        <field name="state">submitted</field>
        <field name="submitted_date" eval="(datetime.now() - relativedelta(days=1))"/>
    </record>

    <record id="ess_demo_request_2" model="ess.request">
        <field name="request_type_id" ref="ess_request_type_equipment"/>
        <field name="requester_kind">employee</field>
        <field name="employee_id" ref="hr.employee_al"/>
        <field name="subject">Laptop replacement</field>
        <field name="description">Current laptop battery no longer holds a charge.</field>
        <field name="priority">high</field>
        <field name="state">approved</field>
        <field name="submitted_date" eval="(datetime.now() - relativedelta(days=3))"/>
        <field name="assigned_user_id" ref="ess_demo_request_manager"/>
    </record>

    <record id="ess_demo_request_3" model="ess.request">
        <field name="request_type_id" ref="ess_request_type_internal_support"/>
        <field name="requester_kind">employee</field>
        <field name="employee_id" ref="hr.employee_qdp"/>
        <field name="subject">VPN access not working from home</field>
        <field name="priority">urgent</field>
        <field name="state">in_progress</field>
        <field name="submitted_date" eval="(datetime.now() - relativedelta(days=2))"/>
        <field name="assigned_user_id" ref="ess_demo_request_manager"/>
    </record>

    <record id="ess_demo_request_4" model="ess.request">
        <field name="request_type_id" ref="ess_request_type_permission"/>
        <field name="requester_kind">employee</field>
        <field name="employee_id" ref="hr.employee_hne"/>
        <field name="subject">Leaving 2 hours early on Thursday</field>
        <field name="priority">low</field>
        <field name="state">closed</field>
        <field name="submitted_date" eval="(datetime.now() - relativedelta(days=10))"/>
        <field name="closed_date" eval="(datetime.now() - relativedelta(days=8))"/>
        <field name="customer_rating">5</field>
        <field name="assigned_user_id" ref="ess_demo_request_manager"/>
    </record>

    <record id="ess_demo_request_5" model="ess.request">
        <field name="request_type_id" ref="ess_request_type_service"/>
        <field name="requester_kind">client</field>
        <field name="partner_id" ref="ess_demo_client_partner"/>
        <field name="subject">Need an update on our project timeline</field>
        <field name="priority">normal</field>
        <field name="state">under_review</field>
        <field name="submitted_date" eval="(datetime.now() - relativedelta(hours=6))"/>
        <field name="assigned_user_id" ref="ess_demo_request_manager"/>
    </record>

    <record id="ess_demo_comment_1" model="ess.request.comment">
        <field name="request_id" ref="ess_demo_request_3"/>
        <field name="author_user_id" ref="ess_demo_request_manager"/>
        <field name="body">Escalated to IT, checking the VPN concentrator logs now.</field>
        <field name="is_internal">False</field>
    </record>
</odoo>
