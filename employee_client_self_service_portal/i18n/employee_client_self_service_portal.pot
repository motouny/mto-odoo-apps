#. module: employee_client_self_service_portal
#: model:mail.template,body_html:employee_client_self_service_portal.mail_template_task_overdue
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif;\">\n"
"                    <p>Hello <t t-out=\"object.employee_id.name\"/>,</p>\n"
"                    <p>Your assigned task is now <strong style=\"color:#d9534f;\">overdue</strong>:</p>\n"
"                    <ul>\n"
"                        <li>\n"
"                            <strong t-out=\"object.name\"/>\n"
"                            <t t-if=\"object.deadline\"> - Deadline was: <t t-out=\"object.deadline\"/></t>\n"
"                        </li>\n"
"                    </ul>\n"
"                    <p>Please update its status as soon as possible.</p>\n"
"                    <p>\n"
"                        <a t-attf-href=\"{{ object.get_base_url() }}/my/assignments\" style=\"background-color:#d9534f;color:#fff;padding:8px 16px;text-decoration:none;border-radius:4px;\">\n"
"                            Update my assignment\n"
"                        </a>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: employee_client_self_service_portal
#: model:mail.template,body_html:employee_client_self_service_portal.mail_template_assignment_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif;\">\n"
"                    <p>Hello <t t-out=\"object.name\"/>,</p>\n"
"                    <p>You still have assignments that need a status update:</p>\n"
"                    <ul>\n"
"                        <t t-foreach=\"ctx.get('pending_tasks', [])\" t-as=\"task\">\n"
"                            <li>\n"
"                                <strong t-out=\"task.name\"/>\n"
"                                <t t-if=\"task.deadline\"> - Deadline: <t t-out=\"task.deadline\"/></t>\n"
"                                - Current status: <t t-out=\"task.state\"/>\n"
"                            </li>\n"
"                        </t>\n"
"                    </ul>\n"
"                    <p>\n"
"                        <a t-attf-href=\"{{ object.get_base_url() }}/my/assignments\" style=\"background-color:#875A7B;color:#fff;padding:8px 16px;text-decoration:none;border-radius:4px;\">\n"
"                            Update my assignments\n"
"                        </a>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: employee_client_self_service_portal
#: model:mail.template,body_html:employee_client_self_service_portal.mail_template_ess_request_status_update
msgid ""
"<div>\n"
"                <p>\n"
"                    Your request <t t-out=\"object.name\"/> (<t t-out=\"object.subject\"/>) is now:\n"
"                    <strong t-out=\"dict(object._fields['state'].selection).get(object.state)\"/>.\n"
"                </p>\n"
"                <p>\n"
"                    <a t-attf-href=\"/my/requests/{{ object.id }}\">View my request</a>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

