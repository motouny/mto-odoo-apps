<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ess_request_team_list" model="ir.ui.view">
        <field name="name">ess.request.team.list</field>
        <field name="model">ess.request.team</field>
        <field name="arch" type="xml">
            <list string="Teams" editable="bottom">
                <field name="name"/>
                <field name="member_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_ess_request_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">ess.request.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
