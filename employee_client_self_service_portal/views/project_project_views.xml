<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_portal_manager" model="ir.ui.view">
        <field name="name">project.project.form.portal.manager</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="portal_manager_id" widget="many2one_avatar_user"/>
                <field name="project_owner_id" widget="many2one_avatar_user"/>
                <field name="attendance_longitude" invisible="1"/>
                <field name="attendance_radius" invisible="1"/>
                <label for="attendance_latitude" string="Attendance Zone"/>
                <field name="attendance_latitude" widget="attendance_zone_map" nolabel="1" colspan="2"/>
            </xpath>
            <xpath expr="//page[@name='description']" position="after">
                <page name="team_members" string="Team Members">
                    <field name="employee_ids" nolabel="1" options="{'no_create': True, 'no_open': False}">
                        <list create="false" delete="false">
                            <field name="name"/>
                            <field name="job_title"/>
                            <field name="work_email" widget="email"/>
                            <field name="work_phone" widget="phone"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
