<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_portal_manager" model="ir.ui.view">
        <field name="name">project.project.form.portal.manager</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="portal_manager_id" widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>
</odoo>
