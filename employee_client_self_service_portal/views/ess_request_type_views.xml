<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ess_request_type_list" model="ir.ui.view">
        <field name="name">ess.request.type.list</field>
        <field name="model">ess.request.type</field>
        <field name="arch" type="xml">
            <list string="Request Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="requester_kind"/>
                <field name="requires_approval"/>
                <field name="default_assigned_team_id"/>
                <field name="client_approver_role"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_ess_request_type" model="ir.actions.act_window">
        <field name="name">Request Types</field>
        <field name="res_model">ess.request.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
