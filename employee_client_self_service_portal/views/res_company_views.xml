<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_attendance_zone" model="ir.ui.view">
        <field name="name">res.company.form.attendance.zone</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Attendance Zone" name="attendance_zone">
                    <field name="attendance_longitude" invisible="1"/>
                    <field name="attendance_radius" invisible="1"/>
                    <field name="attendance_latitude" widget="attendance_zone_map" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
