<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ess_request_form" model="ir.ui.view">
        <field name="name">ess.request.form</field>
        <field name="model">ess.request</field>
        <field name="arch" type="xml">
            <form string="Request">
                <header>
                    <button name="action_start_review" type="object" string="Start Review"
                            invisible="state != 'submitted'"
                            groups="employee_client_self_service_portal.group_ess_request_manager"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight"
                            invisible="state not in ('submitted', 'under_review')"
                            groups="employee_client_self_service_portal.group_ess_request_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('submitted', 'under_review')"
                            groups="employee_client_self_service_portal.group_ess_request_manager"/>
                    <button name="action_request_info" type="object" string="Request Info"
                            invisible="state not in ('submitted', 'under_review')"
                            groups="employee_client_self_service_portal.group_ess_request_manager"/>
                    <button name="action_start_progress" type="object" string="Start Progress"
                            class="oe_highlight" invisible="state != 'approved'"
                            groups="employee_client_self_service_portal.group_ess_request_manager"/>
                    <button name="action_complete" type="object" string="Complete" class="oe_highlight"
                            invisible="state != 'in_progress'"
                            groups="employee_client_self_service_portal.group_ess_request_manager"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'completed'"
                            groups="employee_client_self_service_portal.group_ess_request_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed', 'closed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved,in_progress,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_type_id"/>
                            <field name="requester_kind"/>
                            <field name="employee_id" invisible="requester_kind != 'employee'"/>
                            <field name="partner_id" invisible="requester_kind != 'client'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="assigned_user_id"/>
                            <field name="assigned_team_id"/>
                            <field name="due_date"/>
                            <field name="customer_rating"/>
                        </group>
                    </group>
                    <group>
                        <field name="subject"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Internal Notes"
                              groups="employee_client_self_service_portal.group_ess_request_manager">
                            <field name="internal_notes"/>
                        </page>
                        <page string="Comments">
                            <field name="comment_ids">
                                <list editable="bottom">
                                    <field name="author_user_id"/>
                                    <field name="body"/>
                                    <field name="is_internal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Status History">
                            <field name="status_history_ids" readonly="1">
                                <list>
                                    <field name="change_date"/>
                                    <field name="from_state"/>
                                    <field name="to_state"/>
                                    <field name="changed_by_uid"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ess_request_list" model="ir.ui.view">
        <field name="name">ess.request.list</field>
        <field name="model">ess.request</field>
        <field name="arch" type="xml">
            <list string="Requests" decoration-danger="priority == 'urgent'"
                  decoration-warning="priority == 'high'">
                <field name="name"/>
                <field name="request_type_id"/>
                <field name="subject"/>
                <field name="requester_kind"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="assigned_user_id"/>
                <field name="priority"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_ess_request_search" model="ir.ui.view">
        <field name="name">ess.request.search</field>
        <field name="model">ess.request</field>
        <field name="arch" type="xml">
            <search string="Requests">
                <field name="name"/>
                <field name="subject"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="request_type_id"/>
                <filter string="My Tickets" name="my_tickets" domain="[('assigned_user_id', '=', uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('assigned_user_id', '=', False)]"/>
                <filter string="Open" name="open"
                        domain="[('state', 'not in', ('closed', 'cancelled', 'rejected'))]"/>
                <filter string="Overdue" name="overdue"
                        domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ('closed', 'cancelled', 'rejected', 'completed'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'request_type_id'}"/>
                    <filter string="Assigned To" name="group_assigned" context="{'group_by': 'assigned_user_id'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ess_request" model="ir.actions.act_window">
        <field name="name">Requests</field>
        <field name="res_model">ess.request</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_ess_request_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">No requests yet.</p>
        </field>
    </record>

    <record id="action_ess_request_my_tickets" model="ir.actions.act_window">
        <field name="name">My Tickets</field>
        <field name="res_model">ess.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ess_request_search"/>
        <field name="context">{'search_default_my_tickets': 1, 'search_default_open': 1}</field>
    </record>

    <record id="action_ess_request_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Requests</field>
        <field name="res_model">ess.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ess_request_search"/>
        <field name="context">{'search_default_overdue': 1}</field>
    </record>

    <record id="view_ess_request_pivot" model="ir.ui.view">
        <field name="name">ess.request.pivot</field>
        <field name="model">ess.request</field>
        <field name="arch" type="xml">
            <pivot string="Requests">
                <field name="request_type_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_ess_request_graph" model="ir.ui.view">
        <field name="name">ess.request.graph</field>
        <field name="model">ess.request</field>
        <field name="arch" type="xml">
            <graph string="Requests" type="bar">
                <field name="state"/>
            </graph>
        </field>
    </record>
</odoo>
