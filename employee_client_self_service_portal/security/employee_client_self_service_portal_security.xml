<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="hr_leave_rule_portal_read" model="ir.rule">
            <field name="name">Time Off: portal user reads own</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="hr_leave_rule_portal_update" model="ir.rule">
            <field name="name">Time Off: portal user create/write own non-validated</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">['&amp;', ('employee_id.user_id', '=', user.id), ('state', 'not in', ['validate', 'validate1'])]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="hr_leave_rule_portal_unlink" model="ir.rule">
            <field name="name">Time Off: portal user unlink own unapproved</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', 'in', ['confirm', 'validate1'])]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="hr_leave_allocation_rule_portal_read" model="ir.rule">
            <field name="name">Time Off Allocation: portal user reads own</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="hr_attendance_rule_portal_read" model="ir.rule">
            <field name="name">Attendance: portal user reads own</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="hr_leave_rule_portal_manager_read" model="ir.rule">
            <field name="name">Time Off: portal manager reads team requests</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="domain_force">[('employee_id.project_id.portal_manager_id', '=', user.id)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="employee_portal_task_rule_read" model="ir.rule">
            <field name="name">Portal Task: assignee or project manager reads</field>
            <field name="model_id" ref="model_employee_portal_task"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.project_id.portal_manager_id', '=', user.id)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="project_task_rule_portal_assignee" model="ir.rule">
            <field name="name">Task: portal user reads own assigned tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>
</odoo>
