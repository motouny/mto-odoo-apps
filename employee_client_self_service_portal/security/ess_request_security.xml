<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ess_request" model="ir.module.category">
        <field name="name">Employee &amp; Client Requests</field>
        <field name="sequence">30</field>
    </record>

    <!-- True external-client self-service: separate from the existing
         internal-project "Portal Manager" role, and additive to it. -->
    <record id="group_ess_client" model="res.groups">
        <field name="name">Client</field>
        <field name="category_id" ref="module_category_ess_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- Internal staff who triage/assign/approve requests. -->
    <record id="group_ess_request_manager" model="res.groups">
        <field name="name">Request Manager</field>
        <field name="category_id" ref="module_category_ess_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">

        <!-- ===================== Multi-company (global) ===================== -->
        <record id="rule_ess_request_multi_company" model="ir.rule">
            <field name="name">ESS Request: multi-company</field>
            <field name="model_id" ref="model_ess_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- ===================== ess.request ===================== -->
        <record id="rule_ess_request_requester_own" model="ir.rule">
            <field name="name">ESS Request: requester sees/edits own</field>
            <field name="model_id" ref="model_ess_request"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_ess_request_manager_all" model="ir.rule">
            <field name="name">ESS Request: manager sees all company requests</field>
            <field name="model_id" ref="model_ess_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ess_request_manager'))]"/>
        </record>

        <record id="rule_ess_request_project_manager_read" model="ir.rule">
            <field name="name">ESS Request: client project owner/manager reads project requests</field>
            <field name="model_id" ref="model_ess_request"/>
            <field name="domain_force">['|', ('project_id.portal_manager_id', '=', user.id), ('project_id.project_owner_id', '=', user.id)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- ===================== ess.request.comment ===================== -->
        <record id="rule_ess_comment_requester" model="ir.rule">
            <field name="name">ESS Request Comment: requester sees own non-internal</field>
            <field name="model_id" ref="model_ess_request_comment"/>
            <field name="domain_force">[('is_internal', '=', False), '|', ('request_id.employee_id.user_id', '=', user.id), ('request_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_ess_comment_manager" model="ir.rule">
            <field name="name">ESS Request Comment: manager sees all</field>
            <field name="model_id" ref="model_ess_request_comment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ess_request_manager'))]"/>
        </record>

        <!-- ===================== ess.request.status.history ===================== -->
        <record id="rule_ess_history_requester" model="ir.rule">
            <field name="name">ESS Request History: requester sees own</field>
            <field name="model_id" ref="model_ess_request_status_history"/>
            <field name="domain_force">['|', ('request_id.employee_id.user_id', '=', user.id), ('request_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_ess_history_manager" model="ir.rule">
            <field name="name">ESS Request History: manager sees all</field>
            <field name="model_id" ref="model_ess_request_status_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ess_request_manager'))]"/>
        </record>

        <!-- ===================== ess.portal.notification ===================== -->
        <record id="rule_ess_notification_own" model="ir.rule">
            <field name="name">ESS Notification: own only</field>
            <field name="model_id" ref="model_ess_portal_notification"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

    </data>
</odoo>
