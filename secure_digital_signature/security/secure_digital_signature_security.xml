<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_signature" model="ir.module.category">
        <field name="name">Digital Signature</field>
        <field name="sequence">28</field>
    </record>

    <record id="group_signature_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_signature"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_signature_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_signature"/>
        <field name="implied_ids" eval="[(4, ref('group_signature_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">

        <!-- ===================== Multi-company (global) ===================== -->
        <record id="rule_signature_request_multi_company" model="ir.rule">
            <field name="name">Signature Request: multi-company</field>
            <field name="model_id" ref="model_digital_signature_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- ===================== digital.signature.request ===================== -->
        <record id="rule_signature_request_own" model="ir.rule">
            <field name="name">Signature Request: user sees own</field>
            <field name="model_id" ref="model_digital_signature_request"/>
            <field name="domain_force">[('created_by_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_signature_user'))]"/>
        </record>

        <record id="rule_signature_request_manager_all" model="ir.rule">
            <field name="name">Signature Request: manager sees all company requests</field>
            <field name="model_id" ref="model_digital_signature_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_signature_manager'))]"/>
        </record>

        <!-- ===================== child models: follow the parent request ===================== -->
        <record id="rule_signature_document_own" model="ir.rule">
            <field name="name">Signature Document: follows request ownership</field>
            <field name="model_id" ref="model_digital_signature_document"/>
            <field name="domain_force">[('request_id.created_by_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_signature_user'))]"/>
        </record>
        <record id="rule_signature_document_manager" model="ir.rule">
            <field name="name">Signature Document: manager sees all</field>
            <field name="model_id" ref="model_digital_signature_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_signature_manager'))]"/>
        </record>

        <record id="rule_signature_signer_own" model="ir.rule">
            <field name="name">Signature Signer: follows request ownership</field>
            <field name="model_id" ref="model_digital_signature_signer"/>
            <field name="domain_force">[('request_id.created_by_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_signature_user'))]"/>
        </record>
        <record id="rule_signature_signer_manager" model="ir.rule">
            <field name="name">Signature Signer: manager sees all</field>
            <field name="model_id" ref="model_digital_signature_signer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_signature_manager'))]"/>
        </record>

        <record id="rule_signature_field_own" model="ir.rule">
            <field name="name">Signature Field: follows request ownership</field>
            <field name="model_id" ref="model_digital_signature_field"/>
            <field name="domain_force">[('request_id.created_by_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_signature_user'))]"/>
        </record>
        <record id="rule_signature_field_manager" model="ir.rule">
            <field name="name">Signature Field: manager sees all</field>
            <field name="model_id" ref="model_digital_signature_field"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_signature_manager'))]"/>
        </record>

        <record id="rule_signature_event_own" model="ir.rule">
            <field name="name">Signature Event: follows request ownership</field>
            <field name="model_id" ref="model_digital_signature_event"/>
            <field name="domain_force">[('request_id.created_by_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_signature_user'))]"/>
        </record>
        <record id="rule_signature_event_manager" model="ir.rule">
            <field name="name">Signature Event: manager sees all</field>
            <field name="model_id" ref="model_digital_signature_event"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_signature_manager'))]"/>
        </record>

        <!-- ===================== templates: manager-owned configuration ===================== -->
        <record id="rule_signature_template_multi_company" model="ir.rule">
            <field name="name">Signature Template: multi-company</field>
            <field name="model_id" ref="model_digital_signature_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
