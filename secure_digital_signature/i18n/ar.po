#. module: secure_digital_signature
#: model:mail.template,body_html:secure_digital_signature.mail_template_signature_completed
msgid ""
"<div>\n"
"                <p>\n"
"                    All signers have completed <strong t-out=\"object.subject\"/>\n"
"                    (<t t-out=\"object.name\"/>).\n"
"                </p>\n"
"                <p>\n"
"                    <a t-attf-href=\"{{ object.get_base_url() }}/sign/verify/{{ object.verification_token }}\">\n"
"                        Verify this document online\n"
"                    </a>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: secure_digital_signature
#: model:mail.template,body_html:secure_digital_signature.mail_template_signature_reminder
msgid ""
"<div>\n"
"                <p>Dear <t t-out=\"object.name\"/>,</p>\n"
"                <p>\n"
"                    This is a reminder that <strong t-out=\"object.request_id.subject\"/> is still\n"
"                    waiting for your signature.\n"
"                </p>\n"
"                <p>\n"
"                    <a t-attf-href=\"{{ object.get_base_url() }}/sign/{{ object.token }}\">\n"
"                        Review and Sign\n"
"                    </a>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: secure_digital_signature
#: model:mail.template,body_html:secure_digital_signature.mail_template_signature_invitation
msgid ""
"<div>\n"
"                <p>Dear <t t-out=\"object.name\"/>,</p>\n"
"                <p>\n"
"                    You have been asked to sign <strong t-out=\"object.request_id.subject\"/>\n"
"                    (<t t-out=\"object.request_id.name\"/>).\n"
"                </p>\n"
"                <p>\n"
"                    <a t-attf-href=\"{{ object.get_base_url() }}/sign/{{ object.token }}\">\n"
"                        Review and Sign\n"
"                    </a>\n"
"                </p>\n"
"                <p t-if=\"object.request_id.expiration_date\">\n"
"                    This link expires on <t t-out=\"object.request_id.expiration_date\"/>.\n"
"                </p>\n"
"                <p>This link is personal, do not share it.</p>\n"
"            </div>\n"
"        "
msgstr ""

