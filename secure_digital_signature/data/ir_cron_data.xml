<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_expire_signature_requests" model="ir.cron">
        <field name="name">Digital Signature: Expire Overdue Requests</field>
        <field name="model_id" ref="model_digital_signature_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_requests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_signature_reminders" model="ir.cron">
        <field name="name">Digital Signature: Send Reminders</field>
        <field name="model_id" ref="model_digital_signature_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
