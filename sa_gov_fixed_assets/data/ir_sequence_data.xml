<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_sa_gov_asset" model="ir.sequence">
        <field name="name">Government Asset - MOF Sequence</field>
        <field name="code">sa.gov.asset</field>
        <field name="prefix"></field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_sa_gov_asset_verification" model="ir.sequence">
        <field name="name">Asset Verification Campaign</field>
        <field name="code">sa.gov.asset.verification</field>
        <field name="prefix">VER/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
