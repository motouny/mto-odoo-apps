<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sa_gov_asset_tag_list" model="ir.ui.view">
        <field name="name">sa.gov.asset.tag.list</field>
        <field name="model">sa.gov.asset.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="tag_number"/>
                <field name="asset_id"/>
                <field name="issue_date"/>
                <field name="is_movable"/>
                <field name="safety_risk"/>
                <field name="requires_physical_tag"/>
            </list>
        </field>
    </record>

    <record id="view_sa_gov_asset_tag_form" model="ir.ui.view">
        <field name="name">sa.gov.asset.tag.form</field>
        <field name="model">sa.gov.asset.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="tag_number"/>
                            <field name="issue_date"/>
                        </group>
                        <group>
                            <field name="is_movable"/>
                            <field name="safety_risk"/>
                            <field name="requires_physical_tag" readonly="1"/>
                        </group>
                    </group>
                    <field name="qr_value" readonly="1"/>
                    <p class="text-muted" invisible="requires_physical_tag">
                        This asset does not require a physical tag sticker (safety risk or
                        immovable with no loss-of-identity risk) - it remains coded and
                        tracked. Use the "Asset Tag Label (QR)" report to print a QR sticker
                        when a physical tag is required.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sa_gov_asset_tag" model="ir.actions.act_window">
        <field name="name">Asset Tags</field>
        <field name="res_model">sa.gov.asset.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
