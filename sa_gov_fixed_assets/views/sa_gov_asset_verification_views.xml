<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sa_gov_asset_verification_list" model="ir.ui.view">
        <field name="name">sa.gov.asset.verification.list</field>
        <field name="model">sa.gov.asset.verification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_deadline"/>
                <field name="responsible_id"/>
                <field name="line_count"/>
                <field name="discrepancy_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_sa_gov_asset_verification_form" model="ir.ui.view">
        <field name="name">sa.gov.asset.verification.form</field>
        <field name="model">sa.gov.asset.verification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="%(action_sa_gov_asset_verification_populate_wizard)d" type="action"
                            string="Add Assets" invisible="state == 'done'"/>
                    <button name="%(action_sa_gov_asset_verification_quick_scan_wizard)d" type="action"
                            string="Quick Scan (Barcode / QR / RFID)" invisible="state != 'in_progress'"/>
                    <button name="action_done" type="object" string="Close Campaign"
                            invisible="state != 'in_progress'" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_deadline"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="1"/>
                            <field name="discrepancy_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="asset_id"/>
                            <field name="asset_code"/>
                            <field name="expected_location"/>
                            <field name="inspection_date"/>
                            <field name="found"/>
                            <field name="location_matches"/>
                            <field name="condition_found"/>
                            <field name="discrepancy_type"/>
                            <field name="responsible_user_id"/>
                            <field name="investigation_notes" optional="hide"/>
                        </list>
                    </field>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sa_gov_asset_verification" model="ir.actions.act_window">
        <field name="name">Physical Verification Campaigns (جرد)</field>
        <field name="res_model">sa.gov.asset.verification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
