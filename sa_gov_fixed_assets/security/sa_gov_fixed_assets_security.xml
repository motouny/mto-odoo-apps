<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sa_gov_assets" model="ir.module.category">
        <field name="name">SA Government Assets</field>
        <field name="sequence">26</field>
    </record>

    <record id="group_sa_asset_user" model="res.groups">
        <field name="name">User (Read + Verification Entry)</field>
        <field name="category_id" ref="module_category_sa_gov_assets"/>
    </record>

    <record id="group_sa_asset_officer" model="res.groups">
        <field name="name">Asset Officer</field>
        <field name="category_id" ref="module_category_sa_gov_assets"/>
        <field name="implied_ids" eval="[(4, ref('group_sa_asset_user'))]"/>
    </record>

    <record id="group_sa_asset_manager" model="res.groups">
        <field name="name">Asset Manager</field>
        <field name="category_id" ref="module_category_sa_gov_assets"/>
        <field name="implied_ids" eval="[(4, ref('group_sa_asset_officer'))]"/>
    </record>

    <record id="group_sa_asset_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_sa_gov_assets"/>
        <field name="implied_ids" eval="[(4, ref('group_sa_asset_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- ===================== Multi-company rules ===================== -->
    <record id="rule_asset_multi_company" model="ir.rule">
        <field name="name">Government Asset: multi-company</field>
        <field name="model_id" ref="model_sa_gov_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_verification_multi_company" model="ir.rule">
        <field name="name">Asset Verification: multi-company</field>
        <field name="model_id" ref="model_sa_gov_asset_verification"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_depreciation_line_multi_company" model="ir.rule">
        <field name="name">Asset Depreciation Line: multi-company</field>
        <field name="model_id" ref="model_sa_gov_asset_depreciation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_tag_multi_company" model="ir.rule">
        <field name="name">Asset Tag: multi-company</field>
        <field name="model_id" ref="model_sa_gov_asset_tag"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
