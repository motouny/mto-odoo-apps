<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sa_dga_theme.AppSidebar">
        <div t-if="enabled" class="o_dga_app_sidebar" t-att-class="state.collapsed ? 'o_dga_collapsed' : ''">
            <button type="button" class="o_dga_sidebar_home_btn" t-on-click="onOpenHomeMenu"
                    t-att-title="openHomeMenuLabel" t-att-aria-label="openHomeMenuLabel">
                <i class="fa fa-th-large"/>
                <span class="o_dga_sidebar_app_label" t-esc="openHomeMenuLabel"/>
            </button>
            <div class="o_dga_sidebar_apps" role="menu">
                <t t-foreach="apps" t-as="app" t-key="app.id">
                    <a t-att-href="getHref(app)"
                       class="o_dga_sidebar_app"
                       t-att-class="isActive(app) ? 'o_dga_active' : ''"
                       t-att-title="app.name"
                       role="menuitem"
                       t-on-click.prevent="() => this.onAppClick(app)">
                        <span class="o_dga_sidebar_app_icon">
                            <img t-if="app.webIconData" t-att-src="app.webIconData" alt=""/>
                            <i t-else="" class="fa fa-th-large"/>
                        </span>
                        <span class="o_dga_sidebar_app_label" t-esc="app.name"/>
                    </a>
                </t>
            </div>
            <button type="button" class="o_dga_sidebar_toggle" t-on-click="toggleCollapsed"
                    t-att-title="toggleLabel" t-att-aria-label="toggleLabel">
                <i t-att-class="state.collapsed ? 'oi oi-chevron-right' : 'oi oi-chevron-left'"/>
            </button>
        </div>
    </t>
</templates>
