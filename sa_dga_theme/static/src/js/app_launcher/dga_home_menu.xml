<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sa_dga_theme.DgaHomeMenu">
        <div class="o_dga_home_menu">
            <div class="o_dga_home_menu_header">
                <div class="o_dga_home_menu_search">
                    <i class="fa fa-search"/>
                    <input type="text" t-ref="search"
                           t-att-placeholder="searchPlaceholder"
                           t-model="state.query"
                           t-on-input="onSearchInput"/>
                </div>
                <button type="button" class="o_dga_home_menu_close" t-on-click="goBack" t-att-aria-label="closeLabel" t-att-title="closeLabel">
                    <i class="oi oi-close"/>
                </button>
            </div>
            <div class="o_dga_home_menu_grid" role="menu">
                <t t-foreach="filteredApps" t-as="app" t-key="app.id">
                    <a t-att-href="getHref(app)"
                       class="o_app o_dga_app_card o_dga_home_menu_card"
                       role="menuitem"
                       t-att-title="app.name"
                       t-on-click.prevent="() => this.onAppClick(app)">
                        <div class="o_dga_app_card_icon" t-att-class="accentClass(app)">
                            <img t-if="app.webIconData" t-att-src="app.webIconData" alt=""/>
                            <i t-else="" class="fa fa-th-large"/>
                        </div>
                        <span class="o_dga_app_card_label" t-esc="app.name"/>
                    </a>
                </t>
            </div>
            <div t-if="!filteredApps.length" class="o_dga_home_menu_empty" t-esc="noResultsLabel"/>
        </div>
    </t>
</templates>
