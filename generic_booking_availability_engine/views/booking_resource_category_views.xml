<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_resource_category_list" model="ir.ui.view">
        <field name="name">booking.resource.category.list</field>
        <field name="model">booking.resource.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="resource_count"/>
            </list>
        </field>
    </record>

    <record id="view_booking_resource_category_form" model="ir.ui.view">
        <field name="name">booking.resource.category.form</field>
        <field name="model">booking.resource.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="note" placeholder="Internal note..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_booking_resource_category" model="ir.actions.act_window">
        <field name="name">Resource Categories</field>
        <field name="res_model">booking.resource.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
