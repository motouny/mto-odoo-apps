<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_cancellation_policy_list" model="ir.ui.view">
        <field name="name">booking.cancellation.policy.list</field>
        <field name="model">booking.cancellation.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_booking_cancellation_policy_form" model="ir.ui.view">
        <field name="name">booking.cancellation.policy.form</field>
        <field name="model">booking.cancellation.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <field name="description" placeholder="Explain this policy to customers..."/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="days_before_start"/>
                            <field name="refund_percentage"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_booking_cancellation_policy" model="ir.actions.act_window">
        <field name="name">Cancellation Policies</field>
        <field name="res_model">booking.cancellation.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
