<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_resource_list" model="ir.ui.view">
        <field name="name">booking.resource.list</field>
        <field name="model">booking.resource</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="capacity"/>
                <field name="unit_price"/>
                <field name="is_published"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_booking_resource_kanban" model="ir.ui.view">
        <field name="name">booking.resource.kanban</field>
        <field name="model">booking.resource</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="category_id"/>
                <field name="unit_price"/>
                <field name="currency_id"/>
                <field name="is_published"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <div class="text-muted"><field name="category_id"/></div>
                            <div>
                                <field name="unit_price" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </div>
                            <span class="badge rounded-pill" t-attf-class="#{record.is_published.raw_value ? 'text-bg-success' : 'text-bg-secondary'}">
                                <t t-if="record.is_published.raw_value">Bookable</t>
                                <t t-else="">Not Bookable</t>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_booking_resource_form" model="ir.ui.view">
        <field name="name">booking.resource.form</field>
        <field name="model">booking.resource</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_booking_availability_generator)d" type="action"
                                class="oe_stat_button" icon="fa-calendar" context="{'default_resource_id': id}">
                            <span>Generate Availability</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Deluxe Room - Tower View"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_published"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="unit_price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="min_advance_booking_hours"/>
                            <field name="max_quantity_per_booking"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="responsible_partner_id"/>
                        </group>
                        <group>
                            <field name="cancellation_policy_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Availability">
                            <field name="availability_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="capacity_total"/>
                                    <field name="capacity_booked"/>
                                    <field name="capacity_remaining"/>
                                    <field name="is_blackout"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pricing Rules">
                            <field name="pricing_rule_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="rule_type"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="price"/>
                                    <field name="priority"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_booking_resource_search" model="ir.ui.view">
        <field name="name">booking.resource.search</field>
        <field name="model">booking.resource</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter string="Bookable" name="published" domain="[('is_published', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_booking_resource" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="res_model">booking.resource</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_published': 1}</field>
    </record>
</odoo>
