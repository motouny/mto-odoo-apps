<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_availability_generator_form" model="ir.ui.view">
        <field name="name">booking.availability.generator.form</field>
        <field name="model">booking.availability.generator</field>
        <field name="arch" type="xml">
            <form string="Generate Availability">
                <group>
                    <field name="resource_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="capacity_total"/>
                    <field name="overwrite_existing"/>
                </group>
                <footer>
                    <button string="Generate" name="action_generate" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_booking_availability_generator" model="ir.actions.act_window">
        <field name="name">Generate Availability</field>
        <field name="res_model">booking.availability.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
