<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visitor_department_list" model="ir.ui.view">
        <field name="name">visitor.department.list</field>
        <field name="model">visitor.department</field>
        <field name="arch" type="xml">
            <list string="Departments" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_visitor_department_form" model="ir.ui.view">
        <field name="name">visitor.department.form</field>
        <field name="model">visitor.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="manager_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_visitor_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">visitor.department</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
