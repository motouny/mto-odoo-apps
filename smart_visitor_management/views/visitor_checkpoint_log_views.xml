<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visitor_checkpoint_log_list" model="ir.ui.view">
        <field name="name">visitor.checkpoint.log.list</field>
        <field name="model">visitor.checkpoint.log</field>
        <field name="arch" type="xml">
            <list string="Checkpoint Scan Log" create="0" edit="0" delete="0"
                  decoration-success="scan_result == 'success'"
                  decoration-danger="scan_result != 'success'">
                <field name="scan_datetime"/>
                <field name="visit_id"/>
                <field name="guest_name"/>
                <field name="gate_id"/>
                <field name="scan_type"/>
                <field name="scan_result"/>
                <field name="scanned_by_uid"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_visitor_checkpoint_log_search" model="ir.ui.view">
        <field name="name">visitor.checkpoint.log.search</field>
        <field name="model">visitor.checkpoint.log</field>
        <field name="arch" type="xml">
            <search string="Checkpoint Scan Log">
                <field name="visit_id"/>
                <field name="guest_name"/>
                <filter string="Failed Scans" name="failed" domain="[('scan_result', '!=', 'success')]"/>
                <filter string="Successful Scans" name="success" domain="[('scan_result', '=', 'success')]"/>
                <group expand="0" string="Group By">
                    <filter string="Result" name="group_result" context="{'group_by': 'scan_result'}"/>
                    <filter string="Gate" name="group_gate" context="{'group_by': 'gate_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_visitor_checkpoint_log" model="ir.actions.act_window">
        <field name="name">Checkpoint Scan Log</field>
        <field name="res_model">visitor.checkpoint.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_visitor_checkpoint_log_search"/>
    </record>
</odoo>
