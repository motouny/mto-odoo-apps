<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visitor_guest_form" model="ir.ui.view">
        <field name="name">visitor.guest.form</field>
        <field name="model">visitor.guest</field>
        <field name="arch" type="xml">
            <form string="Guest">
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name_ar"/>
                            <field name="identity_type"/>
                            <field name="identity_number"/>
                            <field name="passport_number"/>
                            <field name="nationality_id"/>
                        </group>
                        <group>
                            <field name="company_name"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_visitor_guest_list" model="ir.ui.view">
        <field name="name">visitor.guest.list</field>
        <field name="model">visitor.guest</field>
        <field name="arch" type="xml">
            <list string="Guests">
                <field name="name"/>
                <field name="identity_type"/>
                <field name="identity_number"/>
                <field name="company_name"/>
                <field name="mobile"/>
            </list>
        </field>
    </record>

    <record id="view_visitor_guest_search" model="ir.ui.view">
        <field name="name">visitor.guest.search</field>
        <field name="model">visitor.guest</field>
        <field name="arch" type="xml">
            <search string="Guests">
                <field name="name"/>
                <field name="identity_number"/>
                <field name="company_name"/>
            </search>
        </field>
    </record>

    <record id="action_visitor_guest" model="ir.actions.act_window">
        <field name="name">Guests</field>
        <field name="res_model">visitor.guest</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
