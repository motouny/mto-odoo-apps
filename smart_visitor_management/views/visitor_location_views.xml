<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visitor_location_list" model="ir.ui.view">
        <field name="name">visitor.location.list</field>
        <field name="model">visitor.location</field>
        <field name="arch" type="xml">
            <list string="Locations" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_visitor_location_form" model="ir.ui.view">
        <field name="name">visitor.location.form</field>
        <field name="model">visitor.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_visitor_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">visitor.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
