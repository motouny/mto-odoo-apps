#. module: smart_visitor_management
#: model:mail.template,body_html:smart_visitor_management.mail_template_visitor_rejected
msgid ""
"<div>\n"
"                <p>Dear <t t-out=\"object.guest_id.name\"/>,</p>\n"
"                <p>\n"
"                    Unfortunately your visit request (<t t-out=\"object.name\"/>) was not approved.\n"
"                </p>\n"
"                <p t-if=\"object.rejection_reason\">\n"
"                    Reason: <t t-out=\"object.rejection_reason\"/>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: smart_visitor_management
#: model:mail.template,body_html:smart_visitor_management.mail_template_visitor_invitation
msgid ""
"<div>\n"
"                <p>Dear <t t-out=\"object.guest_id.name\"/>,</p>\n"
"                <p>\n"
"                    You have been invited by <t t-out=\"object.host_id.name\"/> to visit\n"
"                    <t t-out=\"object.location_id.name\"/> on <t t-out=\"object.visit_start\"/>.\n"
"                </p>\n"
"                <p>Please complete your visitor details using the link below before your visit:</p>\n"
"                <p>\n"
"                    <a t-attf-href=\"/visitor/invitation/{{ object.invitation_token }}\">\n"
"                        Complete My Visitor Registration\n"
"                    </a>\n"
"                </p>\n"
"                <p>This link is personal, do not share it.</p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: smart_visitor_management
#: model:mail.template,body_html:smart_visitor_management.mail_template_visitor_approved
msgid ""
"<div>\n"
"                <p>Dear <t t-out=\"object.guest_id.name\"/>,</p>\n"
"                <p>\n"
"                    Your visit (<t t-out=\"object.name\"/>) has been approved. Please present a valid\n"
"                    ID at the reception desk on arrival.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

