<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_visitor_management" model="ir.module.category">
        <field name="name">Visitor Management</field>
        <field name="sequence">25</field>
    </record>

    <!-- Base: any internal user who may consult the visitor board -->
    <record id="group_visitor_user" model="res.groups">
        <field name="name">Visitor User</field>
        <field name="category_id" ref="module_category_visitor_management"/>
    </record>

    <record id="group_visitor_host" model="res.groups">
        <field name="name">Host Employee</field>
        <field name="category_id" ref="module_category_visitor_management"/>
        <field name="implied_ids" eval="[(4, ref('group_visitor_user'))]"/>
    </record>

    <record id="group_visitor_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="category_id" ref="module_category_visitor_management"/>
        <field name="implied_ids" eval="[(4, ref('group_visitor_user'))]"/>
    </record>

    <record id="group_visitor_security" model="res.groups">
        <field name="name">Security Officer</field>
        <field name="category_id" ref="module_category_visitor_management"/>
        <field name="implied_ids" eval="[(4, ref('group_visitor_user'))]"/>
    </record>

    <record id="group_visitor_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="category_id" ref="module_category_visitor_management"/>
        <field name="implied_ids" eval="[(4, ref('group_visitor_user'))]"/>
    </record>

    <record id="group_visitor_manager" model="res.groups">
        <field name="name">Visitor Manager</field>
        <field name="category_id" ref="module_category_visitor_management"/>
        <field name="implied_ids" eval="[(4, ref('group_visitor_receptionist')),
                                          (4, ref('group_visitor_security'))]"/>
    </record>

    <record id="group_visitor_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_visitor_management"/>
        <field name="implied_ids" eval="[(4, ref('group_visitor_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- ===================== Multi-company rules ===================== -->
    <record id="rule_visit_multi_company" model="ir.rule">
        <field name="name">Visitor Visit: multi-company</field>
        <field name="model_id" ref="model_visitor_visit"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_location_multi_company" model="ir.rule">
        <field name="name">Visitor Location: multi-company</field>
        <field name="model_id" ref="model_visitor_location"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_gate_multi_company" model="ir.rule">
        <field name="name">Visitor Gate: multi-company</field>
        <field name="model_id" ref="model_visitor_gate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_host_multi_company" model="ir.rule">
        <field name="name">Visitor Host: multi-company</field>
        <field name="model_id" ref="model_visitor_host"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_department_multi_company" model="ir.rule">
        <field name="name">Visitor Department: multi-company</field>
        <field name="model_id" ref="model_visitor_department"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_blacklist_multi_company" model="ir.rule">
        <field name="name">Visitor Blacklist: multi-company</field>
        <field name="model_id" ref="model_visitor_blacklist"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_badge_template_multi_company" model="ir.rule">
        <field name="name">Visitor Badge Template: multi-company</field>
        <field name="model_id" ref="model_visitor_badge_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_checkpoint_log_multi_company" model="ir.rule">
        <field name="name">Visitor Checkpoint Log: multi-company</field>
        <field name="model_id" ref="model_visitor_checkpoint_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ===================== Host: own visits only ===================== -->
    <record id="rule_visit_host_own" model="ir.rule">
        <field name="name">Visitor Visit: host sees only own</field>
        <field name="model_id" ref="model_visitor_visit"/>
        <field name="domain_force">[('host_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_visitor_host'))]"/>
    </record>

    <!-- Receptionist / Security / Manager / Auditor see every visit of
         their company (already scoped by the multi-company rule above). -->
    <record id="rule_visit_full_access" model="ir.rule">
        <field name="name">Visitor Visit: full company access</field>
        <field name="model_id" ref="model_visitor_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_visitor_receptionist')),
                                     (4, ref('group_visitor_security')),
                                     (4, ref('group_visitor_auditor')),
                                     (4, ref('group_visitor_manager'))]"/>
    </record>
</odoo>
