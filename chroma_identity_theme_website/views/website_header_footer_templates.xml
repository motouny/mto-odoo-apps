<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Government / Public Sector" header - an OPTIONAL pack, not the
         theme's default: inherits the working Default header
         (search/sign-in/language selector/mobile nav all stay intact)
         and only ADDS an official top utility bar above it - safer than
         reimplementing a header from scratch, and matches how Odoo's own
         "align center"/"align right" header variants are built (light
         xpath additions on template_header_default, not website.layout
         directly - see website/views/website_templates.xml). -->
    <template id="template_header_government" inherit_id="website.template_header_default"
              name="Government / Public Sector Header" active="False">
        <!-- NOT "//header//nav": template_header_default's own xpath
             REPLACES that literal <nav> with a <t t-call="website.navbar">
             wrapper, so the tag no longer exists for a second inheriting
             view to target the same way (found by testing - activating
             this view raised "Element cannot be located in parent view").
             Targeting header's first child instead is robust regardless
             of what that child actually is. -->
        <xpath expr="//header/*[1]" position="before">
            <div class="o_chroma_gov_topbar d-print-none">
                <div class="container d-flex align-items-center justify-content-between py-1 flex-wrap gap-2">
                    <span class="o_chroma_gov_topbar_text small">
                        <t t-esc="website.company_id.name"/>
                    </span>
                    <div class="o_chroma_gov_topbar_links d-flex align-items-center gap-3 small">
                        <a href="/contactus" class="o_chroma_gov_topbar_link">Contact Us</a>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- "Government / Public Sector" footer - an OPTIONAL pack, not the
         theme's default: a full replacement (same pattern as every
         other footer variant in website/views/website_templates.xml -
         each fully replaces #footer), official multi-column layout with
         placeholder policy links, matching the government-appropriate
         structure a public-sector site is expected to have. -->
    <template id="template_footer_government" inherit_id="website.layout"
              name="Government / Public Sector Footer" active="False">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo o_chroma_gov_footer" t-ignore="true" t-if="not no_footer">
                <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Text">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4 pt24 pb24">
                                <h5 class="mb-3" t-esc="website.company_id.name"/>
                                <p class="o_chroma_gov_footer_tagline">
                                    Official website - Kingdom of Saudi Arabia
                                </p>
                                <div class="s_social_media text-start o_not_editable" data-snippet="s_social_media" data-name="Social Media" contenteditable="false">
                                    <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                        <i class="fa fa-facebook rounded-circle shadow-sm o_editable_media"/>
                                    </a>
                                    <a href="/website/social/twitter" class="s_social_media_twitter" target="_blank" aria-label="X">
                                        <i class="fa fa-twitter rounded-circle shadow-sm o_editable_media"/>
                                    </a>
                                    <a href="/website/social/linkedin" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                        <i class="fa fa-linkedin rounded-circle shadow-sm o_editable_media"/>
                                    </a>
                                </div>
                            </div>
                            <div class="col-lg-3 offset-lg-1 pt24 pb24">
                                <h5 class="mb-3">Quick Links</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/contactus">Contact us</a></li>
                                    <li><a href="#">Privacy Policy</a></li>
                                    <li><a href="#">Terms of Use</a></li>
                                    <li><a href="#">Accessibility</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-4 pt24 pb24">
                                <h5 class="mb-3">Contact</h5>
                                <ul class="list-unstyled">
                                    <li><i class="fa fa-envelope fa-fw me-2"/><span><a href="mailto:info@yourcompany.example.com">info@yourcompany.example.com</a></span></li>
                                    <li><i class="fa fa-phone fa-fw me-2"/><span class="o_force_ltr"><a href="tel:+1 555-555-5556">+1 555-555-5556</a></span></li>
                                </ul>
                            </div>
                        </div>
                        <div class="row o_chroma_gov_footer_bottom pt-3 mt-3">
                            <div class="col text-center small">
                                © <span t-field="website.company_id.name"/>. All rights reserved.
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
